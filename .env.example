# Modèle des variables d'environnement. Copie ce fichier en .env.local
# et colle les vraies valeurs toi-même. Ne jamais versionner .env.local.

# Supabase (publiques : URL et clé "publishable" sb_publishable_…,
# protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase clé secrète sb_secret_… : SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Anthropic : SERVEUR UNIQUEMENT
ANTHROPIC_API_KEY=

# Identifiants des agents Managed Agents (étape 4)
AGENT_ID_REDACTEUR=
AGENT_ID_CHEF_CABINET=
ENVIRONMENT_ID_REDACTEUR=
ENVIRONMENT_ID_CHEF_CABINET=

# Secret protégeant les routes cron (étape 5)
CRON_SECRET=
